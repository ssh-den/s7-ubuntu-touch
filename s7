#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

usage() {
    printf 'Usage: ./s7 {fetch|build} RELEASE\n'
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    fetch|build) ;;
    *) usage >&2; exit 2 ;;
esac
if [[ $# != 2 || ! $2 =~ ^[0-9]+\.[0-9]+$ ]]; then
    usage >&2
    exit 2
fi

operation=$1
release=$2
root=$PWD
source build/common.sh
source "$release_dir/profile.sh"
source "$kernel_dir/profile.sh"
source "$root/halium/$halium/profile.sh"

case "$operation" in
    fetch) fetch_sources ;;
    build) build_firmware ;;
esac
