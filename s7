#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

usage() {
    printf 'Usage: ./s7 {fetch|kernel|build} RELEASE\n'
    printf '       ./s7 twrp --help\n'
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    twrp) shift; exec python3 -IB device/twrp.py "$@" ;;
    fetch|kernel|build) ;;
    *) usage >&2; exit 2 ;;
esac
if [[ $# != 2 || ! $2 =~ ^[0-9]+\.[0-9]+$ ]]; then
    usage >&2
    exit 2
fi

operation=$1
release=$2
root=$PWD
source build/common.sh
source "$release_dir/profile.sh"
source "$kernel_dir/profile.sh"
source "$root/halium/$halium/profile.sh"

case "$operation" in
    fetch) fetch_sources ;;
    kernel)
        [[ $kernel == 4.4 ]] || die "The standalone kernel target requires KERNEL=4.4."
        lock_build_inputs
        source "$kernel_dir/build.sh"
        build_kernel
        ;;
    build) build_firmware ;;
esac
